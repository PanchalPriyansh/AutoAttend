# AutoAttend configuration.
#
# Copy this file alongside itself as the real environment file and fill in
# your own values. That file is git-ignored; this template is committed, so
# never put a real credential in here.
#
# Every variable below is read in backend/config.py, and nowhere else.

# --- Database ---------------------------------------------------------
# Required. A local server or an Atlas connection string both work.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db-name>
MONGODB_DB_NAME=AutoAttend

# --- Security ---------------------------------------------------------
# Required, and deliberately has no fallback: the app refuses to start
# without it rather than signing tokens with a default key. Generate one
# with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Must be false for local development over http, or the browser will
# refuse to store the auth cookies and every login will appear to fail.
# Leave it true (the default) for any real deployment over https.
JWT_COOKIE_SECURE=false

# --- Server -----------------------------------------------------------
# development turns on Flask's debug mode. Default: production.
FLASK_ENV=development
PORT=5000

# The single origin allowed to call the API with credentials. It must be
# the exact origin the frontend is served from -- a wildcard is not usable
# here, because the JWT cookies require credentialed CORS.
CORS_ORIGINS=http://localhost:5173

# --- Attendance threshold ---------------------------------------------
# The percentage a student must clear, applied per class. A plain
# configured number, not a model output.
LOW_ATTENDANCE_THRESHOLD=75

# How long a student is left alone about one class after being emailed
# about it. 0 disables the cooldown entirely.
NOTIFICATION_COOLDOWN_DAYS=7

# --- Email ------------------------------------------------------------
# Only needed to actually send. `flask notify-low-attendance --dry-run`
# lists who would be emailed without any of these set.
#
# The four credential-shaped values have no fallback on purpose, so a
# missing one fails loudly instead of mailing from a made-up address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# Use an app password, not your account password.
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=AutoAttend

# STARTTLS. Anything other than an explicit false keeps it on, so a typo
# fails closed rather than sending credentials in the clear.
SMTP_USE_TLS=true
